# Optional: Sakhi starts and runs cleanly without any .env file.
# Add one or more comma-separated Groq API keys to enable live Whisper STT and LLM triage.
GROQ_API_KEYS=gsk_your_groq_api_key_here

# Optional: Sarvam AI key for natural Hindi/Marathi speech (Bulbul v3).
# Without it, or if credits run out, Sakhi falls back to the device voice.
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# Optional: Postgres for conversations (docker compose up -d).
# Without it the apps fall back to data/sakhi-store.json.
DATABASE_URL=postgres://sakhi:sakhi@localhost:5432/sakhi
